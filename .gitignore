# Generated configuration (written by `make config`)
config/config.generated.mk

# Dependencies downloaded and built by `make config`
external-libs/

# Build outputs
bin/
python/u3lib.so
python/u3lib.d

# macOS / editor cruft
.DS_Store
__pycache__/
*.pyc

# LaTeX build artifacts (keep Manual.tex, Manual.pdf, References.bib, figures)
doc/*.aux
doc/*.bbl
doc/*.blg
doc/*.fdb_latexmk
doc/*.fls
doc/*.log
doc/*.out
doc/*.synctex.gz

# Benchmark reproduction artifacts (keep results.{csv,json} + runner scripts).
# Per-run agent workspaces and frozen snapshots are large and machine-specific.
agents/benchmarks/*/task*-*/
agents/benchmarks/*/schedule*.json
agents/benchmarks/snapshots/
